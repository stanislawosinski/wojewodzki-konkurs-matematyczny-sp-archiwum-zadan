      "choices": [
        {
          "label": "1",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mrow><msup><mn>10</mn><mn>421</mn></msup><mo>+</mo><mn>6</mn></mrow><mn>6</mn></mfrac></math>"
