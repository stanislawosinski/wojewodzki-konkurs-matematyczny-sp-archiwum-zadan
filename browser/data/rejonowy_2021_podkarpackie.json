    {
      "id": "rejonowy_2021_podkarpackie_q10",
      "number": 10,
      "page": 4,
      "type": "closed_single",
      "points": 1,
      "topics": [
        "trójkąty",
        "pole i obwód",
        "potęgi i pierwiastki"
      ],
      "prompt_html": "<p>Dane są dwa trójkąty równoboczne o bokach równych 3 cm oraz <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mn>7</mn></msqrt></math> cm. Ile wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>4</mn></mfrac></math> sumy pól tych trójkątów?</p>",
      "choices": [
        {
          "label": "A",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>9</mn><mo>+</mo><mn>3</mn><msqrt><mn>7</mn></msqrt></math>"
        },
        {
          "label": "B",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><msqrt><mn>3</mn></msqrt><mn>8</mn></mfrac></math>"
