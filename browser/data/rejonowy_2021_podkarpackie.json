        },
        {
          "label": "D",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mn>115</mn><mn>3</mn></mroot></math>"
        },
        {
          "label": "E",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><msqrt><mn>7</mn></msqrt></math>"
