        {
          "label": "A",
          "html": "1012"
        },
        {
          "label": "B",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>506</mn><mn>2</mn></msup></math>"
        },
        {
          "label": "C",
