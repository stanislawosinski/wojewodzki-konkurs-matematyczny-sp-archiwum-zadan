      "type": "closed_single",
      "points": 1,
      "topics": [
        "inne"
      ],
      "prompt_html": "<p>Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>1011</mn><mo>−</mo><mn>1009</mn><mo>+</mo><mn>1007</mn><mo>−</mo><mn>1005</mn><mo>+</mo><mo>…</mo><mo>+</mo><mn>7</mn><mo>−</mo><mn>5</mn><mo>+</mo><mn>3</mn><mo>−</mo><mn>1</mn></math> jest równa:</p>",
