          "label": "D",
          "html": "11"
        },
        {
          "label": "E",
          "html": "12"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "D",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Wiek = 2020 − rok urodzenia = suma cyfr roku. Dla roku 2009: 2+0+0+9 = 11 oraz 2020−2009 = 11. Zgadza się, więc Adam ma 11 lat.</p>"
        }
      }
