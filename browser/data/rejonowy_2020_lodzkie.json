          "html": "1000 : 100"
        },
        {
          "label": "D",
          "html": "1 000 000 : 1"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "A",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Rzeczywisty prostokąt: 400m×500m = 40000cm×50000cm, pole = 2·10^9 cm². Pole na planie = 2000 cm². Stosunek pól = 1:10^6 = (skala liniowa)². Skala liniowa = 1:1000. Sprawdzenie: 400m:1000=40cm, 500m:1000=50cm, 40·50=2000 cm² — zgadza się.</p>"
        }
      }
    },
    {
      "id": "rejonowy_2020_lodzkie_q7",
      "number": 7,
