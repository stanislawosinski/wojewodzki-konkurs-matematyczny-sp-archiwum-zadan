        "model": {
          "answer": "A",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>a = 3√6+2√6+5√2−5√6 = 5√2 — niewymierna.</p><p>b = (10√3−√3)/(3√3) = 9√3/3√3 = 3 — wymierna.</p><p>c = √[(25−2)+(2√2−√2)²] = √(23+2) = √25 = 5 — wymierna.</p><p>Niewymierna jest tylko a.</p>"
