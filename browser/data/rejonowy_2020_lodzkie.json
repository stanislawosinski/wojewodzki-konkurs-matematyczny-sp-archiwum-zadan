        {
          "label": "D",
          "html": "o 75%"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "B",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Kolejne obniżki mnożą pozostałe wydatki: 0,8·0,75·0,65 = 0,39, czyli zostało 39% wydatków, więc łączna obniżka wynosi 61%.</p>"
        }
      }
    },
    {
      "id": "rejonowy_2020_lodzkie_q6",
      "number": 6,
      "page": 2,
      "type": "closed_single",
      "points": 2,
      "topics": [
        "proporcjonalność prosta",
        "pole i obwód"
      ],
      "prompt_html": "<p>Sad zajmuje powierzchnię prostokąta o wymiarach 400m x 500m. Na planie jego powierzchnia wynosi 2000cm². Plan sporządzono w skali</p>",
      "choices": [
        {
          "label": "A",
          "html": "1 : 1000"
        },
        {
          "label": "B",
          "html": "1000 : 10"
        },
        {
