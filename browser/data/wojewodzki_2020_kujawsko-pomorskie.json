      "points": 2,
      "topics": [
        "potęgi i pierwiastki"
      ],
      "prompt_html": "<p>Dodajemy pewną liczbę składników, z których każdy równa się 2, tak, aby otrzymać <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>11</mn></msup></math>. Ile składników występuje w tej sumie?</p>",
      "choices": [],
      "figures": [],
      "answer": {
        "correct": "1024 (2¹⁰)",
        "solution_html": "<p>Suma <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>n</mi></math> składników równych 2 wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>n</mi></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>2</mn><mi>n</mi><mo>=</mo><msup><mn>2</mn><mn>11</mn></msup></mrow></math>, skąd <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>=</mo><mfrac><msup><mn>2</mn><mn>11</mn></msup><mn>2</mn></mfrac><mo>=</mo><msup><mn>2</mn><mn>10</mn></msup><mo>=</mo><mn>1024</mn></mrow></math>.</p>"
      }
    },
