      "topics": [
        "potęgi i pierwiastki"
      ],
      "prompt_html": "<p>Wartość wyrażenia <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mo>−</mo><mo>(</mo><mo>(</mo><mfrac><mn>0,4</mn><msup><mn>2</mn><mn>2</mn></msup></mfrac><mo>−</mo><mn>1,3</mn><mo>·</mo><mfrac><mn>6</mn><mn>13</mn></mfrac><mo>)</mo><mo>:</mo><msup><mrow><mo>(</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>)</mo></math> jest</p>",
      "choices": [
