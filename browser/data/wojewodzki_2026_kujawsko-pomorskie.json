      ],
      "prompt_html": "<p>Która figura ma pole <strong>inne</strong> niż trapez o podstawach <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>b</mi></math> oraz wysokości <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>h</mi></math>? Wybierz właściwą odpowiedź spośród podanych.</p>",
      "choices": [
        { "label": "A", "html": "Prostokąt o wymiarach <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>(</mo><mi>a</mi><mo>+</mo><mi>b</mi><mo>)</mo></mrow></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>0,5</mn><mi>h</mi></mrow></math>." },
