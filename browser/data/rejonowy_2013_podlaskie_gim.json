        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "B",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>(n-2)+n+(n+2)=39 ⇒ 3n=39 ⇒ n=13. Liczby: 11,13,15. Największa: 15.</p>"
        }
      }
    },
