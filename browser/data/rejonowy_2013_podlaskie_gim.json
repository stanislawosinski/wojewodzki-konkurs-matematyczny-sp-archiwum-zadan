        "statystyka opisowa",
        "równania z jedną zmienną"
      ],
      "prompt_html": "<p>Michał uzyskał średnią z czterech sprawdzianów równą 25 punktów. Ile punktów musi on uzyskać w kolejnym sprawdzianie, aby średnia z pięciu sprawdzianów była równa 26?</p>",
      "choices": [
        {
          "label": "A",
          "html": "26"
        },
        {
          "label": "B",
          "html": "27"
        },
        {
          "label": "C",
          "html": "29"
        },
        {
          "label": "D",
          "html": "30"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "D",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Suma 4 sprawdzianów = 4·25=100. Potrzebna suma 5 sprawdzianów = 5·26=130. Brakuje 130-100=30 punktów.</p>"
        }
      }
    },
