L\"><mrow><msqrt><mrow><msup><mn>8</mn><mn>2</mn></msup><mo>−</mo><msup><mn>4</mn><mn>2</mn></msup></mrow></msqrt><mo>=</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></mrow></math>, więc <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>e</mi><mo>=</mo><mn>12</mn><mo>+</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></mrow></math>.</p><p>Średnia: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mover><mi>x</mi><mo>¯</mo></mover><mo>=</mo><mfrac><mrow><mo>−</mo><mn>20</mn><mo>−</mo><mn>10</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>11</mn><msqrt><mn>3</mn></msqrt><mo>+</mo><msqrt><mn>3</mn></msqrt><mo>+</mo><mn>16</mn><mo>+</mo><mn>12</mn><mo>+</mo><mn>4</mn><msqrt><mn>3</mn></msqrt></mrow><mn>5</mn></mfrac><mo>=</mo><mfrac><mrow><mn>8</mn><mo>+</mo><mn>6</mn><msqrt><mn>3</mn></msqrt></mrow><mn>5</mn></mfrac></mrow></math>. Ponieważ <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>6</mn><msqrt><mn>3</mn></msqrt><mo>=</mo><msqrt><mn>108</mn></msqrt></mrow></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>10</mn><mo>&lt;</mo><msqrt><mn>108</mn></msqrt><mo>&lt;</mo><mn>11</mn></mrow></math>, mamy <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mover><mi>x</mi><mo>¯</mo></mover><mo>≈</mo><mfrac><mrow><mn>8</mn><mo>+</mo><mn>10,39</mn></mrow><mn>5</mn></mfrac><mo>≈</mo><mn>3,68</mn></mrow></math>, zatem <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>n</mi><mo>=</mo><mn>3</mn></mrow></math>.</p>",
