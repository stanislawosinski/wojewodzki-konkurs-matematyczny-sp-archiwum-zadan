      ],
      "prompt_html": "<p>Janek i Piotr ważą razem 96 kilogramów. Piotr i Michał ważą razem 93 kilogramy, a Michał i Janek 97 kilogramów. Ile waży Janek?</p>",
      "choices": [],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
