          "html": "100"
        },
        {
          "label": "D",
          "html": "36"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "A",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>5×5×5 = 125 sześcianików. Niepomalowane to wnętrze: (5−2)³ = 3³ = 27.</p>"
        }
      }
    },
