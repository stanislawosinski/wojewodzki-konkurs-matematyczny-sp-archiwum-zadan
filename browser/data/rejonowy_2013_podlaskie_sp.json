      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "55 lat",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Suma wieku 31 marynarzy = 31·23 = 713. Z kapitanem: 32·24 = 768. Kapitan = 768−713 = 55 lat.</p>"
        }
      }
    },
    {
