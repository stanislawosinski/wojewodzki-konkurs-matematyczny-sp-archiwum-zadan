      ],
      "prompt_html": "<p>Oblicz:</p><p><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mi>a</mi><mo>=</mo><mfrac><mrow><mo>[</mo><mo>(</mo><mo>−</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>)</mo><mo>·</mo><mfrac><mn>8</mn><mn>9</mn></mfrac><mo>−</mo><mn>2</mn><mo>]</mo><mo>·</mo><mo>[</mo><mo>(</mo><mo>−</mo><mn>1,5</mn><mo>)</mo><mo>·</mo><mfrac><mn>8</mn><mn>9</mn></mfrac><mo>+</mo><mn>2</mn><mo>]</mo></mrow><mrow><mo>|</mo><mo>−</mo><mn>10</mn><mo>|</mo><mo>·</mo><msup><mrow><mo>(</mo><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>)</mo></mrow><mn>2</mn></msup><mo>·</mo><msup><mrow><mo>(</mo><mfrac><msqrt><mn>2</mn></msqrt><mn>2</mn></mfrac><mo>)</mo></mrow><mn>2</mn></msup></mrow></mfrac></mrow></math></p>",
      "choices": [],
