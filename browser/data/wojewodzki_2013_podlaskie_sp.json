          "label": "A",
          "html": "12 godzin"
        },
        {
          "label": "B",
          "html": "24 godzin"
        },
        {
          "label": "C",
          "html": "48 godzin"
        },
        {
          "label": "D",
          "html": "16 godzin"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "B",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Dopływ: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>6</mn></mfrac></math>/h, odpływ: <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>8</mn></mfrac></math>/h. Netto <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>1</mn><mn>6</mn></mfrac><mo>−</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>24</mn></mfrac></math>/h, więc 24 godziny.</p>"
        }
      }
    },
