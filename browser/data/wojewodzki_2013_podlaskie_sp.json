        "model": {
          "answer": "D",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Dla graniastosłupa prostego o podstawie n-kąta: ściany n+2, wierzchołki 2n, krawędzie 3n. Suma: 6n+2=50 ⇒ n=8 (ośmiokąt).</p>"
        }
