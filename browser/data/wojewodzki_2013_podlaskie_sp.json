          "label": "D",
          "html": "12 lat"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "A",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Suma wieku dzieci: 13+10+6=29. Ojciec: 41. Różnica: 12. Co roku różnica maleje o 3−1=2 (dzieci razem rosną o 3, ojciec o 1). 12/2=6 lat.</p>"
        }
      }
    },
