      "topics": [
        "równania z jedną zmienną"
      ],
      "prompt_html": "<p>Ojciec ma 41 lat, jego starszy syn 13, córka 10 lat, a najmłodsze dziecko 6 lat. Za ile lat ojciec będzie miał tyle lat, ile jego dzieci razem?</p>",
      "choices": [
