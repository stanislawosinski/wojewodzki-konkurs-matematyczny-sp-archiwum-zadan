        },
        {
          "label": "D",
          "html": "32"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "A",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Palindrom trzycyfrowy ma postać <em>aba</em>; podzielność przez 4 zależy od dwóch ostatnich cyfr <em>ba</em> = 10b+a, czyli 2b+a ≡ 0 (mod 4). Dla a∈{4,8} b parzyste (5 możliwości każde), dla a∈{2,6} b nieparzyste (5 każde), dla a nieparzystego brak. Razem 10+10 = 20.</p>"
        }
      }
