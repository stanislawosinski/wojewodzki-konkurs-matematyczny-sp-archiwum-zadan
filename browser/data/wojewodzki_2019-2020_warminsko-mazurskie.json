        "correct": "A3",
        "solution_html": null,
        "model": {
          "answer": "A",
          "by": "sonnet",
          "agrees": false,
          "solution_html": "<p>216 = 2³·3³, 621 = 3³·23. Obie liczby są podzielne przez 3³ = 27 — nieparzystą liczbę dwucyfrową. Odpowiedź: Tak, uzasadnienie 3.</p>"
        }
      }
