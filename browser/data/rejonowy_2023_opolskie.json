      "prompt_html": "<p>Przy każdym zdaniu wpisz TAK lub NIE.</p><p>Czy prawdą jest, że:</p>",
      "choices": [
        {
          "label": "1",
          "html": "Dwie spośród liczb <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mn>27,008</mn><mn>3</mn></mroot></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msqrt><mfrac><mn>3</mn><mn>507</mn></mfrac></msqrt></math>, <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mroot><mn>10000</mn><mn>3</mn></mroot></math> są wymierne."
        },
        {
          "label": "2",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>16</mn><msqrt><mn>17</mn></msqrt><mo>&gt;</mo><mn>17</mn><msqrt><mn>15</mn></msqrt></math>"
        },
        {
          "label": "3",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><msup><mn>2</mn><mn>2021</mn></msup><mo>+</mo><msup><mn>2</mn><mn>2022</mn></msup><mo>&lt;</mo><msup><mn>2</mn><mn>2023</mn></msup></math>"
