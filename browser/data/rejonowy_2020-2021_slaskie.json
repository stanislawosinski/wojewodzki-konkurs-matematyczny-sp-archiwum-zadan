        },
        {
          "label": "III",
          "html": "Suma miar kątów <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>y</mi></math> i <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>z</mi></math> wynosi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>180</mn><mo>°</mo></mrow></math>."
        }
