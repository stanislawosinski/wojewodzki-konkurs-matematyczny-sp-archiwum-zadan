          "label": "B",
          "html": "18"
        },
        {
          "label": "C",
          "html": "20"
        },
        {
          "label": "D",
          "html": "30"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "C",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Za 150 zł kupujemy 15 pudełek, otrzymując 15 kuponów. 15 kuponów / 3 = 5 dodatkowych pudełek gratis. Łącznie 15+5=20 pudełek.</p>"
        }
