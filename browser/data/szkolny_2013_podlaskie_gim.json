          "answer": "C",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Za 150 zł kupuje się 150/10 = 15 pudełek → 15 kuponów → 15/3 = 5 pudełek gratis. Razem 15 + 5 = 20 pudełek (odpowiedź z listy).</p>"
        }
