        "model": {
          "answer": "B",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Ania starsza od Eli o 4·3=12 lat. Ela=e, Ania=e+12=7e → e=2, Ania=14. Zosia jest 2 odstępy młodsza od Ani: 14-6=8.</p>"
