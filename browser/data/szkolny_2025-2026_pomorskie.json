      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "45",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Ania = 0,75·Krysia = 15 ⇒ Krysia = 20.</p><p>Ania = 1,5·Monika = 15 ⇒ Monika = 10.</p><p>Razem: 15+20+10 = 45.</p>"
        }
      }
    },
