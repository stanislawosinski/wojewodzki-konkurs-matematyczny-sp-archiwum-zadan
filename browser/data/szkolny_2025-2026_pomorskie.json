      "topics": [
        "reszta z dzielenia",
        "potęgi i pierwiastki"
      ],
      "prompt_html": "<p>Wyznacz resztę z dzielenia liczby <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><msup><mn>2</mn><mn>2025</mn></msup><mo>+</mo><msup><mn>3</mn><mn>2026</mn></msup></mrow></math> przez 3. Odpowiedź uzasadnij.</p>",
      "choices": [],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "2",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>3^2026 dzieli się przez 3, więc 3^2026 ≡ 0 (mod 3).</p><p>2 ≡ −1 (mod 3), więc 2^2025 ≡ (−1)^2025 = −1 ≡ 2 (mod 3).</p><p>Suma ≡ 2+0 = 2 (mod 3). Reszta wynosi 2.</p>"
        }
      }
    },
