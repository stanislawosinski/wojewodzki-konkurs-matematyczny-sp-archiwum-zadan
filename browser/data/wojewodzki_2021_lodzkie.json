        "solution_html": null,
        "model": {
          "answer": "pod górę 40 km/h, z góry 60 km/h",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>u–pod górę, d–z góry, płasko 50 km/h (25/50=0,5 h). 10/u+6/d=21 min=7/20 h; 6/u+10/d=19 min. Podstawiając x=1/u,y=1/d: x+y=1/24, x−y=1/120 ⇒ x=1/40, y=1/60. u=40, d=60.</p>"
        }
