    {
      "id": "wojewodzki_2021_lodzkie_q6",
      "number": 6,
      "page": 2,
      "type": "closed_single",
      "points": 5,
      "topics": [
        "wyrażenia algebraiczne"
      ],
      "prompt_html": "<p>Wiadomo, że liczba <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>a</mi></math> spełnia warunek <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>0</mn><mo>&lt;</mo><mi>a</mi><mo>&lt;</mo><mn>5</mn></math>. Wówczas wyrażenie <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mo>|</mo><mi>a</mi><mo>−</mo><mn>5</mn><mo>|</mo><mo>−</mo><mo>|</mo><mn>6</mn><mo>−</mo><mi>a</mi><mo>|</mo></mrow></math> przyjmuje wartość:</p>",
      "choices": [
        {
          "label": "A",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>−</mo><mn>11</mn></math>"
        },
        {
          "label": "B",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>2</mn><mi>a</mi><mo>−</mo><mn>1</mn></math>"
        },
        {
          "label": "C",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>2</mn><mi>a</mi><mo>−</mo><mn>11</mn></math>"
        },
        {
          "label": "D",
          "html": "<math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mo>−</mo><mn>1</mn></math>"
        },
        {
          "label": "E",
