        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "D",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Dla 0&lt;a&lt;5: a−5&lt;0 ⇒ |a−5|=5−a; 6−a&gt;0 ⇒ |6−a|=6−a.</p><p>(5−a)−(6−a) = −1.</p>"
        }
