      "prompt_html": "<p>Średnia wieku 15-osobowej drużyny wynosi 17 lat. Oblicz średnią wieku tej drużyny wraz z trenerem, który ma 41 lat.</p>",
      "choices": [],
      "figures": [],
      "answer": {
