      "topics": [
        "kąty",
        "kombinatoryka"
      ],
      "prompt_html": "<p>Ile co najwyżej kątów ostrych może utworzyć 6 leżących na płaszczyźnie półprostych o wspólnym początku?</p>",
      "choices": [
        {
