      "topics": [
        "równania z jedną zmienną"
      ],
      "prompt_html": "<p>Krzyś policzył drzewa w sadzie i powiedział, że <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>5</mn><mn>6</mn></mfrac></math> wszystkich drzew plus półtora drzewa jest równe liczbie drzew w tym sadzie. Ile drzew jest w tym sadzie?</p>",
      "choices": [],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "9",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>(5/6)x + 1,5 = x ⇒ 1,5 = (1/6)x ⇒ x = 9. Sprawdzenie: 5/6·9 = 7,5; 7,5+1,5 = 9.</p>"
        }
      }
    },
    {
      "id": "szkolny_2010-2011_warminsko-mazurskie_q12",
      "number": 12,
