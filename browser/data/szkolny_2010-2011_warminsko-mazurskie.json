        "model": {
          "answer": "A",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Rzeczywista szerokość: 20 cm × 20 = 400 cm. Na planie 1:50: 400 cm / 50 = <b>8 cm</b>.</p>"
        }
      }
    },
