      "topics": [
        "kąty"
      ],
      "prompt_html": "<p>Trzy proste przecinają się tak jak na rysunku. Ile stopni ma kąt <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mi>α</mi></math>?</p>",
      "choices": [
