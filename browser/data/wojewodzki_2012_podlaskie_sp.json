        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "C",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Graniastosłup o podstawie 10-kąta: krawędzi <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>3</mn><mo>·</mo><mn>10</mn><mo>=</mo><mn>30</mn></math>, ścian <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>10</mn><mo>+</mo><mn>2</mn><mo>=</mo><mn>12</mn></math>. Różnica <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mn>30</mn><mo>-</mo><mn>12</mn><mo>=</mo><mn>18</mn></math>.</p>"
        }
      }
    },
    {
      "id": "wojewodzki_2012_podlaskie_sp_q3",
      "number": 3,
