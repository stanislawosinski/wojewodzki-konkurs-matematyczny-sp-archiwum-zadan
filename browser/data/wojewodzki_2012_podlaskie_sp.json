        "wojewodzki_2012_podlaskie_sp_q12_fig1.png"
      ],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "180 000 litrów",
          "by": "opus+sonnet",
          "agrees": null,
          "corroborated": true,
          "solution_html": "<p>Graniastosłup o przekroju trapezowym; średnia głębokość = (2,2+0,8)/2 = 1,5 m. Objętość = 15·8·1,5 = 180 m³ = 180 000 l.</p>"
        }
