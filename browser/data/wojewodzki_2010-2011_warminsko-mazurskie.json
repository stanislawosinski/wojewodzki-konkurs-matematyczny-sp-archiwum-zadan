          "html": "1 kg"
        },
        {
          "label": "D",
          "html": "1,5 kg"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "C",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>c + m = 34, c + m/2 = 17,5. Odejmując: m/2 = 16,5, więc m = 33. Stąd c = 34 − 33 = 1 kg.</p>"
        }
      }
    },
