          "html": "5000"
        },
        {
          "label": "C",
          "html": "2500"
        },
        {
          "label": "D",
          "html": "2000"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "D",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>5 kotów w 5 godzin łapie 5 myszy, więc 1 kot w 1 godzinę łapie 1/5 myszy. 100 kotów w 100 godzin: 100·100·(1/5)=2000.</p>"
        }
