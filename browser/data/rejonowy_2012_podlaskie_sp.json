      "topics": [
        "równania z jedną zmienną"
      ],
      "prompt_html": "<p>Z naczynia wyparowało <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mfrac><mn>2</mn><mn>5</mn></mfrac></math> wody. Ile wody było początkowo w naczyniu, jeśli pozostało w nim 36 litrów?</p>",
      "choices": [
        {
          "label": "A",
          "html": "40 litrów"
        },
        {
          "label": "B",
          "html": "54 litry"
        },
        {
          "label": "C",
          "html": "60 litrów"
        },
        {
          "label": "D",
          "html": "90 litrów"
        }
      ],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "C",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Wyparowało 2/5, więc zostało 3/5 objętości = 36 l. Całość = 36 : 3/5 = 36 · 5/3 = 60 litrów.</p>"
        }
      }
    },
    {
