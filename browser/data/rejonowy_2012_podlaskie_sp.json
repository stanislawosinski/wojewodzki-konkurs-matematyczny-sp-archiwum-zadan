      "points": 2,
      "topics": [
        "proporcjonalność prosta"
      ],
      "prompt_html": "<p>Odcinek w skali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>3</mn><mo>:</mo><mn>1</mn></mrow></math> ma długość 18 cm. Jaką długość ma ten odcinek w skali <math xmlns=\"http://www.w3.org/1998/Math/MathML\"><mrow><mn>1</mn><mo>:</mo><mn>3</mn></mrow></math>?</p>",
      "choices": [],
      "figures": [],
      "answer": {
        "correct": null,
        "solution_html": null,
        "model": {
          "answer": "2 cm",
          "by": "sonnet",
          "agrees": null,
          "solution_html": "<p>Skala 3:1 oznacza, że rysunek jest 3 razy większy od rzeczywistości: długość rzeczywista = 18 : 3 = 6 cm. W skali 1:3 rysunek jest 3 razy mniejszy od rzeczywistości: 6 : 3 = 2 cm.</p>"
        }
      }
    },
